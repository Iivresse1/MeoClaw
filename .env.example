# 复制为 .env 后填入真实值：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# 必填：API Key（也兼容 API_KEY）
OPENAI_API_KEY=sk-your-key-here

# 可选：模型名（默认 gpt-4o-mini，也兼容 MODEL）
OPENAI_MODEL=gpt-4o-mini

# 可选：自建/代理网关地址（不填则用官方默认；也兼容 BASE_URL）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：Tavily 检索 Key（WebSearchTool / searchAgent 用；不配则检索工具返回缺 Key 说明）
# TAVILY_API_KEY=tvly-your-key-here

# 本地 Bridge 安全配置（通常由应用自动生成 token）
# MEOCLAW_BRIDGE_PORT=8931
# MEOCLAW_BRIDGE_TOKEN=change-me
# MEOCLAW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# 工作区 shell：docker 为默认安全模式；host 仅供可信测试
MEOCLAW_SANDBOX=docker
MEOCLAW_SANDBOX_IMAGE=meoclaw-sandbox:latest
MEOCLAW_SANDBOX_NETWORK=0
